# Hosted values come from Supabase → Project Settings → API. Never put a secret key here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Pl@ntNet key from my.plantnet.org (never PUBLIC_).
PLANTNET_API_KEY=
# Optional, tests only: 1 disables every external call (Pl@ntNet, GBIF, iNaturalist).
# FLORA_OFFLINE_EXTERNAL=1
