{
  "permissions": {
    "allow": [
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git commit:*)",
      "Bash(npm run check)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:db)",
      "Bash(npm run db:reset)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push * --delete*)",
      "Bash(git push --all *)",
      "Bash(git push * --all *)",
      "Bash(git push * --all)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror *)",
      "Bash(git push * --mirror)",
      "Bash(gh pr merge:*)",
      "mcp__claude_ai_Github__merge_pull_request",
      "mcp__claude_ai_Github__delete_repository",
      "mcp__claude_ai_Supabase__delete_branch",
      "mcp__claude_ai_Supabase__merge_branch",
      "mcp__claude_ai_Supabase__reset_branch",
      "mcp__claude_ai_Supabase__pause_project",
      "mcp__claude_ai_Supabase__create_project",
      "mcp__claude_ai_Vercel__pause_project",
      "mcp__claude_ai_Vercel__buy_domain",
      "mcp__claude_ai_Vercel__buy_domains",
      "mcp__claude_ai_Vercel__buy_single_domain",
      "mcp__claude_ai_Vercel__create_or_transfer_domain",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-mcp.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/related-tests.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/status-reminder.sh\""
          }
        ]
      }
    ]
  }
}
